---
import Layout from '../layouts/Layout.astro';
import Avatar from '../components/Avatar.astro';
import Footbar from '../components/Footbar.astro';
import Menu from '../components/Menu.astro';
---

<Layout>
	<main class="min-h-screen flex flex-col justify-between items-center px-4 py-6 md:py-10 max-w-2xl mx-auto text-center">
		<!-- Menú superior con botón de cambio de modo centrado -->
		<header class="w-full flex justify-center items-center">
			<Menu />
		</header>

		<!-- Bloque central -->
		<div class="flex flex-col items-center gap-8 my-auto w-full">
			<Avatar />

			<div class="space-y-3">
				<h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50 transition-colors">
					Saludos, soy <span class="font-bold bg-gradient-to-r from-[#f59e0b] via-[#ec4899] to-[#3b82f6] bg-clip-text text-transparent">devestevenson</span>
				</h1>
				<h2 class="text-xl sm:text-2xl md:text-3xl font-normal text-neutral-500 dark:text-neutral-400 tracking-tight transition-colors">
					UX Designer &amp; Digital Product Creator
				</h2>
			</div>

			<div class="flex flex-wrap justify-center items-center gap-3 sm:gap-4 pt-2">
				<a
					href="https://www.hopino.online/"
					target="_blank"
					rel="noopener noreferrer"
					class="group relative inline-flex items-center justify-center p-[1.5px] rounded-full bg-gradient-to-r from-[#f59e0b] via-[#ec4899] to-[#3b82f6] shadow-xs hover:shadow-lg hover:shadow-rose-500/20 transition-all duration-300 hover:scale-105 cursor-pointer"
				>
					<span class="px-6 py-2.5 rounded-full bg-white dark:bg-[#0c0d0e] text-neutral-900 dark:text-neutral-100 font-medium text-sm sm:text-base group-hover:bg-transparent group-hover:text-white transition-all duration-300">
						Hopino
					</span>
				</a>
				<a
					href="https://www.guiaty.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="group relative inline-flex items-center justify-center p-[1.5px] rounded-full bg-gradient-to-r from-[#f59e0b] via-[#ec4899] to-[#3b82f6] shadow-xs hover:shadow-lg hover:shadow-rose-500/20 transition-all duration-300 hover:scale-105 cursor-pointer"
				>
					<span class="px-6 py-2.5 rounded-full bg-white dark:bg-[#0c0d0e] text-neutral-900 dark:text-neutral-100 font-medium text-sm sm:text-base group-hover:bg-transparent group-hover:text-white transition-all duration-300">
						Guiaty
					</span>
				</a>
				<a
					href="https://poem-five-kappa.vercel.app/"
					target="_blank"
					rel="noopener noreferrer"
					class="group relative inline-flex items-center justify-center p-[1.5px] rounded-full bg-gradient-to-r from-[#f59e0b] via-[#ec4899] to-[#3b82f6] shadow-xs hover:shadow-lg hover:shadow-rose-500/20 transition-all duration-300 hover:scale-105 cursor-pointer"
				>
					<span class="px-6 py-2.5 rounded-full bg-white dark:bg-[#0c0d0e] text-neutral-900 dark:text-neutral-100 font-medium text-sm sm:text-base group-hover:bg-transparent group-hover:text-white transition-all duration-300">
						Pohemaro
					</span>
				</a>
			</div>
		</div>

		<!-- Footer centrado -->
		<footer class="w-full pt-8">
			<Footbar />
		</footer>
	</main>
</Layout>

