---
import Layout from '../layouts/Layout.astro';

import Menubar from '../components/Menubar.astro';
import Profile from '../components/Profile.astro';
import Projects from '../components/Projects.astro';
import Footbar from '../components/Footbar.astro';
---

<Layout>

	<div class="px-4">

		<main class="w-full max-w-[600px] flex flex-col gap-[100px] mx-auto border-r border-l border-[#333333]">

			<section>
				<Menubar />
			</section>

			<section>
				<Profile />
			</section>

			<section>
				<Projects />
			</section>

			<section>
				<Footbar />
			</section>
			
		</main>

	</div>

</Layout>
