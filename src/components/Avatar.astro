---
---

<div class="relative size-36 mx-auto flex items-center justify-center group">
  <!-- Anillo SVG simulando barra de progreso circular con degradado -->
  <svg class="absolute inset-0 size-full -rotate-90 pointer-events-none" viewBox="0 0 144 144">
    <defs>
      <linearGradient id="avatar-progress-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#f59e0b" />
        <stop offset="30%" stop-color="#ec4899" />
        <stop offset="70%" stop-color="#8b5cf6" />
        <stop offset="100%" stop-color="#3b82f6" />
      </linearGradient>
    </defs>

    <!-- Pista de fondo de la barra -->
    <circle
      cx="72"
      cy="72"
      r="66"
      stroke="currentColor"
      stroke-width="3"
      fill="none"
      class="text-neutral-200 dark:text-neutral-800 transition-colors duration-300"
    />

    <!-- Barra de progreso degradada animada -->
    <circle
      cx="72"
      cy="72"
      r="66"
      stroke="url(#avatar-progress-gradient)"
      stroke-width="3.5"
      stroke-linecap="round"
      fill="none"
      stroke-dasharray="415"
      stroke-dashoffset="415"
      class="progress-ring-circle transition-all duration-700 ease-out"
    />
  </svg>

  <!-- Imagen del Avatar -->
  <div class="size-30 overflow-hidden rounded-full ring-2 ring-white dark:ring-[#0c0d0e] shadow-md transition-transform duration-300 group-hover:scale-105">
    <img
      class="w-full h-full object-cover"
      src="/devestevenson.jpg"
      alt="Foto de perfil de devestevenson"
    />
  </div>
</div>

<style>
  .progress-ring-circle {
    animation: fillProgress 1.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  /* Animación de carga: simula que la barra se va llenando hasta el 82% */
  @keyframes fillProgress {
    0% {
      stroke-dashoffset: 415;
    }
    100% {
      stroke-dashoffset: 75;
    }
  }

  /* Al pasar el cursor se llena al 100% con un ligero resplandor */
  .group:hover .progress-ring-circle {
    stroke-dashoffset: 0;
    filter: drop-shadow(0 0 6px rgba(236, 72, 153, 0.4));
  }
</style>
