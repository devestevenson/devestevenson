    class="group relative inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-white/10 bg-white/[0.03] backdrop-blur-xl text-xs font-medium text-neutral-300 hover:text-white hover:border-white/25 hover:bg-white/[0.07] shadow-[0_0_20px_-5px_rgba(255,255,255,0.08)] transition-all duration-300 cursor-pointer"
