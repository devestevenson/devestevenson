---

<section class="flex flex-col gap-5 p-5 sm:p-[50px] border-b border-t border-[#f0f0f0]">
    <h2 class="text-2xl font-extrabold text-[#888888]">Proyectos realizados</h2>
    <ul class="flex flex-col gap-4">
        {dataWorks.map((work) => (
            <a href={work.link} target="_blank" class="flex justify-between items-center">
                <div>
                    <span class="text-2xl font-semibold">{work.title},</span>
                    {/* <span class="text-sm text-[#888888]">({work.tag})</span> */}
                </div>
                <span class="text-xl"><i class="ph ph-arrow-up-right"></i></span>
            </a>
        ))}
</section>