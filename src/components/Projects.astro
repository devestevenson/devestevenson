---
const dataWorks = [
    {
        title: "pohemaro.com",
        link: "https://www.pohemaro.com/",
        tag: "diseño y desarrollo"
    },
    {
        title: "marmól.com",
        link: "https://todoenmarmol.com/",
        tag: "diseño y desarrollo"
    },
    {
        title: "kernink.com",
        link: "https://kerninkestudioold.vercel.app/",
        tag: "diseño y desarrollo"
    },
    {
        title: "gotour.com",
        link: "https://gotour13.com/",
        tag: "desarrollo"
    },
    {
        title: "codigoc13.com",
