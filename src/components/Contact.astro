<section class="px-[25px] sm:px-[50px] py-[50px] border-t border-b border-[#333333]">

    <h3 class="contact-title text-xl opacity-0 translate-y-4">Estoy disponible.</h3>

    <a href="https://wa.me/3022444817?text=Hola,%20me%20interesan%20tus%20servicios." rel="noopener noreferrer" target="_blank" class="contact-chat w-fit text-xl font-bold opacity-0 translate-y-4 text-[#999999] hover:text-[#D0D0D0]">
        Chat
    </a>

</section>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const contactElements = [
        '.contact-title',
        '.contact-chat'
    ];

    contactElements.forEach((element, index) => {
        gsap.to(element, {
            opacity: 1,
            y: 0,
            duration: 0.8,
            delay: index * 0.2,
            ease: 'power2.out',
            scrollTrigger: {
                trigger: element,
                start: 'top 80%',
                toggleActions: 'play none none reverse'
            }
        });
    });
</script>
